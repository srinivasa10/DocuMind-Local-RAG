COLLECTION_NAME=enterprise_knowledge
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:5173
DEBUG_TRACE=true
